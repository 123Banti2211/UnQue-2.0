# Server Port
PORT=5001

# JWT Secret Key for token signing and verification
JWT_SECRET=unque_super_secret_jwt_key_2026

# Option 1: Local MongoDB or MongoDB Atlas
MONGO_URL=mongodb://127.0.0.1:27017/unque_db

# Option 2: AWS DocumentDB (with TLS enabled - AWS Default)
# Download CA bundle: wget https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# MONGO_URL=mongodb://<docdb_user>:<docdb_password>@<cluster-endpoint>.docdb.amazonaws.com:27017/unque_db?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
# DOCDB_CA_PATH=./global-bundle.pem

# Option 3: AWS DocumentDB (if TLS is disabled in Cluster Parameter Group)
# MONGO_URL=mongodb://<docdb_user>:<docdb_password>@<cluster-endpoint>.docdb.amazonaws.com:27017/unque_db?replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

